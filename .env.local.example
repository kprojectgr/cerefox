# ── Cerefox Local Deployment ──────────────────────────────────────────────────
# Copy this to .env and adjust values for your setup.
#
# This configures the fully local stack (docker-compose.local.yml):
#   Postgres + pgvector + PostgREST + Cerefox + MCP HTTP server
#   Embeddings via Ollama (no cloud API keys needed)

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=cerefox
POSTGRES_PASSWORD=cerefox
POSTGRES_DB=cerefox

# ── PostgREST JWT ─────────────────────────────────────────────────────────────
# Must be at least 32 characters. Change this for any non-localhost deployment.
PGRST_JWT_SECRET=super-secret-jwt-token-for-local-dev-only-do-not-use-in-production

# JWT signed with the secret above: {"role":"cerefox"}, no expiry.
# Generate it by running:
#   python scripts/generate_jwt.py
# Then paste the output here.
CEREFOX_SUPABASE_KEY=PASTE_JWT_HERE

# ── Database (used by deploy scripts via psycopg2) ────────────────────────────
CEREFOX_DATABASE_URL=postgresql://cerefox:cerefox@localhost:5432/cerefox

# ── Ollama ────────────────────────────────────────────────────────────────────
CEREFOX_EMBEDDER=ollama
CEREFOX_OLLAMA_BASE_URL=http://localhost:11434
CEREFOX_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── API token (optional) ─────────────────────────────────────────────────────
# If set, all /api/* and MCP HTTP requests require Authorization: Bearer <token>
# Leave empty for localhost-only use.
CEREFOX_API_TOKEN=
